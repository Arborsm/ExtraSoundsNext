{
  "schemaVersion": 1,
  "id": "${id}",
  "name": "${name}",
  "version": "${version}",
  "authors": ["${authors}"],
  "contributors": ["${contributors}"],
  "contact": {
    "sources": "${sources_url}",
    "issues": "${issues_url}",
    "homepage": "${homepage_url}"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.discord": "${discord_url}"
      }
    }
  },
  "description": "${description}",
  "icon": "assets/extrasounds/icon.png",
  "license": "${license}",
  "environment": "*",
  "accessWidener": "aw/${minecraft}.accesswidener",
  "entrypoints": {
    "main": [
    ],
    "client": [
      "dev.arbor.extrasoundsnext.platform.fabric.ExtraSoundsNextFabricClient"
    ],
    "modmenu": [
      "dev.arbor.extrasoundsnext.platform.fabric.ModMenuIntegration"
    ],
    "jei_mod_plugin": [
      "dev.arbor.extrasoundsnext.integration.jei.ExtraSoundsJeiPlugin"
    ],
    "sounds_generator": [
      "dev.arbor.extrasoundsnext.mapping.DefaultAutoGenerator"
    ]
  },
  "mixins": [
    "extrasounds.mixins.json"
  ]
}
